<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of Sir Correctifs Pulsar. They cover the plugin's pure logic
    (Source/Logic), whose sources are included here: they run without the game
    and without Pulsar.

      dotnet test tests/tests.csproj
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>sir-correctifs-pulsar.tests</AssemblyName>
    <RootNamespace>SirCorrectifsPulsar.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Source\Logic\*.cs" Link="Logic\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

</Project>
