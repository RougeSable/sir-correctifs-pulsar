<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests de Sir Correctifs Pulsar. Ils couvrent la logique pure du greffon
    (Source/Logique), dont les sources sont incluses ici : ils tournent sans le
    jeu et sans Pulsar.

      dotnet test tests/tests.csproj
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>sir-correctifs-pulsar.tests</AssemblyName>
    <RootNamespace>SirCorrectifsPulsar.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Source\Logique\*.cs" Link="Logique\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

</Project>
